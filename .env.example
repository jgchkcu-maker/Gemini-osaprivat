# Stable Antigravity auth (recommended)
ANTIGRAVITY_REFRESH_TOKEN=
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Optional if it is not embedded in a composite refresh token.
ANTIGRAVITY_PROJECT_ID=

# Hard default is Gemini 3.8 Flash High. Override only at deploy time.
ANTIGRAVITY_MODEL=gemini-3.8-flash-high

# Optional temporary alternative to refresh-token auth. Access tokens expire.
# ANTIGRAVITY_ACCESS_TOKEN=

# Optional MCP bearer protection. Enable only if your MCP client can send this header.
# MCP_SHARED_SECRET=

# Optional custom Antigravity/Cloud Code endpoint.
# ANTIGRAVITY_API_ENDPOINT=
