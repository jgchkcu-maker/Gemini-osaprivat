# Dashboard access. Required for managing the account pool.
ADMIN_PASSWORD=

# Vercel Upstash integration usually creates KV_REST_API_URL / KV_REST_API_TOKEN.
# Canonical Upstash names are supported too, including Vercel custom STORAGE_ aliases.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# STORAGE_URL=
# STORAGE_TOKEN=

# Optional dedicated encryption seed. If omitted, the secret Redis token is used as the seed.
# ACCOUNT_ENCRYPTION_KEY=

# Existing Antigravity/desktop OAuth client credentials. Used for imported/legacy accounts.
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Dedicated Google OAuth client of type "Web application" for one-click Add Account.
# Authorized redirect URI:
# https://YOUR-PROJECT.vercel.app/api/accounts/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# The model is hard-locked in source code to gemini-3.8-flash-high.
# It cannot be overridden by an environment variable.

# Legacy single-account fallback (optional once the pool has accounts).
# ANTIGRAVITY_REFRESH_TOKEN=refreshToken|projectId|managedProjectId
# ANTIGRAVITY_PROJECT_ID=
# ANTIGRAVITY_ACCESS_TOKEN=

# Optional MCP bearer protection. Enable only if your MCP client can send this header.
# MCP_SHARED_SECRET=

# Optional custom Antigravity/Cloud Code endpoint.
# ANTIGRAVITY_API_ENDPOINT=
