# Dashboard access. Required for managing the account pool.
ADMIN_PASSWORD=

# Vercel Upstash integration usually creates KV_REST_API_URL / KV_REST_API_TOKEN.
# Canonical Upstash names are supported too, including Vercel custom STORAGE_ aliases.
# Redis is also used for distributed MCP rate limiting when configured.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# STORAGE_URL=
# STORAGE_TOKEN=

# Strongly recommended in production: a dedicated encryption seed separate from Redis credentials.
# If omitted, the secret Redis token is still used as the legacy-compatible encryption seed.
# ACCOUNT_ENCRYPTION_KEY=

# Optional provider-native Antigravity OAuth override.
# Leave both unset to use the embedded public native-app OAuth client.
# If overriding, set BOTH values; never set only one half of the pair.
# ANTIGRAVITY_CLIENT_ID=
# ANTIGRAVITY_CLIENT_SECRET=
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Optional dedicated Google OAuth client of type "Web application" for seamless one-click Add Account.
# Authorized redirect URI:
# https://YOUR-PROJECT.vercel.app/api/accounts/oauth/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Optional stable origin for OAuth when users open a Vercel preview URL.
# Example: https://gemini-osaprivat.vercel.app
# GOOGLE_OAUTH_APP_URL=
# Optional full callback override (must match the Google OAuth client exactly).
# GOOGLE_OAUTH_REDIRECT_URI=

# The model is hard-locked in source code to gemini-3.8-flash-high.
# It cannot be overridden by an environment variable.

# Legacy single-account fallback (optional once the pool has accounts).
# ANTIGRAVITY_REFRESH_TOKEN=refreshToken|projectId|managedProjectId
# ANTIGRAVITY_PROJECT_ID=
# ANTIGRAVITY_ACCESS_TOKEN=

# Optional MCP bearer protection. Enable only if your MCP client can send this header.
# Without it the MCP endpoint is public and uses the lower public rate limit.
# MCP_SHARED_SECRET=

# Distributed MCP rate limits (requests per minute per hashed client identity).
# Defaults: public=10, bearer-authenticated=60. Requires Redis to enforce across instances.
# MCP_RATE_LIMIT_PUBLIC_PER_MINUTE=10
# MCP_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=60

# Optional custom Antigravity/Cloud Code endpoint.
# ANTIGRAVITY_API_ENDPOINT=
